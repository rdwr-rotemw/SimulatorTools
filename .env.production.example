# ============================================================================
# Production .env Template for Rocky Linux 9 Server
# Create this file at: /opt/simtools/.env
# Then run: chmod 600 /opt/simtools/.env
# ============================================================================

# ============================================================================
# GITHUB CONTAINER REGISTRY
# ============================================================================
# Replace with your GitHub username or organization name
GITHUB_REPO_OWNER=rdwr-rotemw
IMAGE_TAG=latest

# ============================================================================
# ENVIRONMENT
# ============================================================================
ENVIRONMENT=production
ENV=production
DEBUG=false

# ============================================================================
# DATABASE - PostgreSQL
# Note: User and database will be created automatically on first container start
# ============================================================================
DATABASE_TYPE=postgresql
PG_HOST=postgres
PG_PORT=5432
PG_DB=simulators
PG_USER=simtools_user
# Generate with: openssl rand -base64 32
PG_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# ============================================================================
# DATABASE - MongoDB
# Note: User will be created automatically on first container start
# ============================================================================
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=simulators
MONGO_USER=simtools_mongo
# Generate with: openssl rand -base64 32
MONGO_PASSWORD=CHANGE_ME_MONGO_PASSWORD

# ============================================================================
# SECURITY - JWT Authentication
# ============================================================================
# Generate with: python3 -c 'import secrets; print(secrets.token_urlsafe(64))'
# This is used to sign authentication tokens - keep it secret!
# Example generated key:
JWT_SECRET_KEY=SECRET_KEY_CHANGE_ME_TO_A_STRONG_RANDOM_VALUE
JWT_ALGORITHM=HS256
# Token expiration in minutes (60 = 1 hour)
ACCESS_TOKEN_EXPIRE_MINUTES=60

# ============================================================================
# ADMIN USER - Pre-hashed Password
# ============================================================================
# IMPORTANT: When using argon2 hashes in .env files with Docker Compose,
# you MUST escape $ characters by doubling them ($$) to prevent variable substitution.
#
# Generate a hash with: python -c "from argon2 import PasswordHasher; print(PasswordHasher().hash('YourPasswordHere'))"
#
# Example format (every $ is escaped as $$):
# ADMIN_PASSWORD_HASH=$$argon2id$$v=19$$m=65536,t=3,p=4$$SALT_HERE$$HASH_HERE
#
# DO NOT commit the real hash - set this in your actual .env file only!
ADMIN_PASSWORD_HASH=CHANGE_ME_GENERATE_ARGON2_HASH

# Note: Using port 8443 to avoid conflict with Sapro's sathrd processes on standard ports
CORS_ORIGINS=https://192.168.1.100:8443

# ============================================================================
# API SETTINGS
# ============================================================================
BACKEND_PORT=8000
# Using port 8443 for HTTPS to avoid Sapro conflicts
API_BASE_URL=https://192.168.1.100:8443/api

# ============================================================================
# SAPRO INTEGRATION
# ============================================================================
SAPRO_IP=172.17.166.10
SAPRO_PORT=2100

# SSH Settings - Used for executing Sapro commands (sapcnsl, etc.)
# Backend uses network_mode: host to bind to simulator IPs for IRP sends,
# but executes Sapro commands via SSH to localhost (production) or remote host (dev)
SAPRO_SSH_HOST=172.17.166.10
SAPRO_SSH_USER=root
SAPRO_SSH_PASSWORD=radware

# ============================================================================
# PATHS
# ============================================================================
DOWNLOAD_PATH=/tmp/irp_files

# ============================================================================
# LOGGING
# ============================================================================
LOG_LEVEL=INFO

# ============================================================================
# UI
# ============================================================================
REACT_APP_API_BASE_URL=/api
REACT_APP_API_TIMEOUT=30000
REACT_APP_DEBUG=false
