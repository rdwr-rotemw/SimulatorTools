# ===================================================================
# SAPRO Proxy Test XMF
#
# Flow per CC request:
# 1. init_action registers device IP with proxy on port 8889 (plain HTTP)
# 2. SA_xml_request_forwarder forwards CC's HTTPS request to port 8888
# 3. Proxy uses registered IP + SNMP to resolve and serve the JAR
#
# NOTE: SA_xml_proxyfwd_strmap (manual says "stringmap") does NOT work
# for replacing strings in forwarded requests — only responses.
# Registration via separate HTTP call is the working solution.
#
# Place in /opt/sapro/xml/ and reference from device map <Soap> section:
#   SoapModFile = "/opt/sapro/xml/test_proxy.xmf"
# ===================================================================

%soap_init_action
    set myIP [SA_getmyip]
    SA_xml_debugflag 1
    SA_xml_debugfile "proxy_$myIP.dbg"
    SA_xml_debugputs "=== Proxy XMF init for $myIP ==="

    # Register device IP with proxy (fire-and-forget, plain HTTP)
    set sock [socket 127.0.0.1 8889]
    fconfigure $sock -translation binary
    set body $myIP
    set bodyLen [string length $body]
    puts -nonewline $sock "POST /_register HTTP/1.0\r\nContent-Length: $bodyLen\r\n\r\n$body"
    flush $sock
    close $sock

    SA_xml_debugputs "=== Registered $myIP with proxy, setting up forwarder ==="
    SA_xml_request_forwarder 127.0.0.1 8888 300
